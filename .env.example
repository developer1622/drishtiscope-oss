# ==============================================================================
# DrishtiScope (दृष्टिScope) - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env or export these variables in your shell environment.
# Note: Never commit actual API keys or secret tokens to git repositories.

# ------------------------------------------------------------------------------
# 1. Daemon & Telemetry Server Settings
# ------------------------------------------------------------------------------
# Address to bind the HTTP and WebSocket server (Default: :8080 or 127.0.0.1:8080)
HTTP_ADDR=:8080

# Ingestion Mode: auto | real | ebpf | mock (Default: auto)
#   auto: Detects kernel capabilities; uses eBPF if privileged, otherwise falls back to real
#   real: Zero-root /proc & sysfs host telemetry on Linux/WSL2; tasklist & ETW on Windows
#   ebpf: Nanosecond Linux kernel tracepoints via BPF ring buffers; ebpfcore.sys on Windows
#   mock: Synthetic simulation generator for offline UI development and CI
MODE=auto

# Default observed process command name (Default: agy)
TARGET_COMM=agy

# Target Process ID to monitor (0 = auto-detect by TARGET_COMM)
TARGET_PID=0

# Metric snapshot interval in milliseconds (Default: 1500)
SNAPSHOT_MS=1500

# Path to static frontend dist directory (Auto-detected if empty)
# STATIC_DIR=frontend/dist

# Path to SQLite time-series database file (Default: drishtiscope.db)
DB_PATH=drishtiscope.db

# ------------------------------------------------------------------------------
# 2. Security & Access Control
# ------------------------------------------------------------------------------
# Optional Bearer auth token for remote deployments (min 16 characters)
# If unset, DrishtiScope operates in loopback-only mode for OWASP A01/A07 safety.
# AUTH_TOKEN=your-secure-random-token-here-min-16-chars

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Allow insecure WebSocket connections across origins (Default: false)
WS_INSECURE=false

# Rate limiting settings for API endpoints
RATE_LIMIT_RPS=40
RATE_LIMIT_BURST=80

# Trust X-Forwarded-For headers from reverse proxies (Default: false)
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 3. AI Observability Copilot (Optional External LLMs)
# ------------------------------------------------------------------------------
# DrishtiScope Copilot includes a 100% local deterministic rule-engine that works
# with ZERO external API keys. To enable natural language analysis, set any of:
# GEMINI_API_KEY=your-gemini-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# GROQ_API_KEY=your-groq-api-key-here

# ------------------------------------------------------------------------------
# 4. Engine Resource Limits & Tuning
# ------------------------------------------------------------------------------
# Maximum HTTP request body size in bytes (Default: 65536 = 64KB)
MAX_BODY_BYTES=65536

# Maximum concurrent WebSocket client connections (Default: 128)
MAX_WS_CLIENTS=128

# Maximum historical sliding window data points in memory (Default: 500)
MAX_HISTORY=500

# Graceful shutdown timeout in seconds (Default: 10)
SHUTDOWN_TIMEOUT_SEC=10
